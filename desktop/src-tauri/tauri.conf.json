{
  "$schema": "../tauri.schema.json",
  "productName": "Sanatan AI",
  "version": "0.1.0",
  "identifier": "com.sanatanai.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sanatan AI",
        "minWidth": 400,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "./icons/main.bmp"
      },
      "wix": {
        "bannerPath": "./icons/main.bmp",
        "dialogImagePath": "./icons/main.bmp"
      }
    }
  }
}
