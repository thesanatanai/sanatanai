    "@next/third-parties": "^16.4.6",
    "@react-oauth/google": "^0.13.5",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tavily/core": "^1.1.0",
    "@types/mdast": "^4.0.4",
    "google-auth-library": "^11.3.4",
    "gsap": "^3.15.1",
    "jose": "^6.2.17",
    "js-cookie": "^3.0.8",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.19.1",
    "lenis": "^1.3.27",
    "lucide-react": "1.73.0",
    "mdast": "^3.0.0",
    "mermaid": "^12.3.0",
    "mongoose": "^9.12.1",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-speech-recognition": "^4.0.1",
    "resend": "^6.38.1",
    "streamdown": "^2.7.1",
    "three": "^0.187.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
