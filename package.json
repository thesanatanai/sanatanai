{
  "name": "sanatan-ai",
  "version": "2.4.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "preinstall": "npx only-allow pnpm",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run --config vitest.smoke.config.mts",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "trace": "next dev --internal-trace"
  },
  "dependencies": {
