    "eslint": "^10",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "katex": "$katex",
    "mermaid": "$mermaid",
    "postcss-selector-parser": "^6.1.5"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
